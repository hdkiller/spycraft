{
  "schemaVersion": 1,
  "id": "erikcraft",
  "version": "${version}",
  "name": "ErikCraft",
  "description": "A custom Minecraft mod built for Erik by Dad!",
  "authors": [
    "László & Erik"
  ],
  "contact": {
    "homepage": "https://github.com/hdkiller/mc"
  },
  "license": "MIT",
  "icon": "assets/erikcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.erikcraft.ErikCraftMod"
    ],
    "client": [
      "com.erikcraft.client.ErikCraftModClient"
    ]
  },
  "mixins": [
    "erikcraft.mixins.json",
    {
      "config": "erikcraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}